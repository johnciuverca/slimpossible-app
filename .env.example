# Public Supabase project configuration for future browser authentication.
# Copy this file to .env.local. Use the owner's Project URL and public anon key.
# Never add a service-role key, database password, token, or real value here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
