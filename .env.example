# Public Supabase project configuration for browser authentication.
# Copy this file to .env.local. The key may be the public publishable key or
# legacy anon key during migration; never use a secret/service-role key here.
# Never add a service-role key, database password, token, or real value here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
